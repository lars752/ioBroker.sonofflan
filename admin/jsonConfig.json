    "tabDevices": {
      "type": "panel",
      "label": "Geräte",
      "items": {
        "_info2": {
          "type": "staticText",
          "sm": 12,
          "text": "Optional: Geräte manuell ergänzen oder überschreiben – z. B. devicekey für reinen LAN-Betrieb ohne Konto, feste IP (falls mDNS im Netz nicht funktioniert) oder abweichende UIID."
        },
        "devices": {
          "type": "table",
          "sm": 12,
          "newLine": true,
          "items": [
            {
              "type": "text",
              "attr": "deviceid",
              "title": "Geräte-ID (10 Zeichen)",
              "width": "18%",
              "filter": true,
              "sort": true,
              "default": ""
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "20%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "host",
              "title": "IP[:Port] (optional)",
              "width": "18%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "devicekey",
              "title": "devicekey (optional)",
              "width": "30%",
              "default": ""
            },
            {
              "type": "number",
              "attr": "uiid",
              "title": "UIID (optional)",
              "width": "14%",
              "min": 0
            }
          ]
        }
      }
    },
    "tabExpert": {
      "type": "panel",
      "label": "Erweitert",
      "items": {
        "mdnsInterface": {
          "type": "text",
          "label": "mDNS-Netzwerkschnittstelle (IP, optional)",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "help": "Nur bei mehreren Netzwerkkarten nötig, z. B. 192.168.1.10"
        },
        "sensorRefresh": {
          "type": "checkbox",
          "label": "Messwerte von POW/TH/DualR3 im LAN alle ~5 s anfordern",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "newLine": true
        },
        "energyInterval": {
          "type": "number",
          "label": "Abfrageintervall Energie-Verlauf (Sekunden)",
          "min": 300,
          "max": 86400,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "newLine": true
        },
        "createRaw": {
          "type": "checkbox",
          "label": "Rohdaten-Datenpunkte anlegen (raw.params / raw.command)",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "newLine": true
        },
        "_hdr3": {
          "type": "header",
          "text": "Eigene eWeLink-App (optional)",
          "size": 3,
          "newLine": true
        },
        "_info3": {
          "type": "staticText",
          "sm": 12,
          "text": "Nur ausfüllen, wenn eigene App-Zugangsdaten aus dem eWeLink-Developer-Portal verwendet werden sollen. Leer = Standard-App wie in SonoffLAN."
        },
